#!/usr/bin/env bash
# Pre-commit: the fast checks on the staged files only (ruff for Python, Biome for the viewer's source). The full
# suite (tests, types, the build) stays in scripts/check.sh. Enable once per clone: git config core.hooksPath scripts/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }

# macOS ships bash 3.2 (no mapfile), so the lists are read line by line.
python=()
while IFS= read -r path; do python+=("$path"); done < <(staged '*.py')
if ((${#python[@]})); then
  uv run ruff format --check "${python[@]}"
  uv run ruff check "${python[@]}"
fi

# Biome runs from web/, where biome.json and its install live, so the paths drop their web/ prefix.
web=()
while IFS= read -r path; do web+=("${path#web/}"); done < <(staged 'web/src/*' 'web/test/*' 'web/build.mjs')
if ((${#web[@]})); then
  if [[ ! -x web/node_modules/.bin/biome ]]; then
    echo "pre-commit: Biome is not installed, run npm ci --prefix web" >&2
    exit 1
  fi
  (cd web && node_modules/.bin/biome check --no-errors-on-unmatched "${web[@]}")
fi
