{
  "name": "gemmy-viewer",
  "private": true,
  "description": "The gemmy viewer page: TypeScript source, built by esbuild into src/gemmy/viewer (dev only, not in the wheel)",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit -p .",
    "lint": "biome check src test build.mjs",
    "format": "biome format --write src test build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/d3-contour": "3.0.6",
    "@types/d3-polygon": "3.0.2",
    "@types/three": "0.160.0",
    "esbuild": "0.24.0",
    "three": "0.160.0",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.5",
    "d3-contour": "4.0.3",
    "d3-polygon": "3.0.2",
    "fit-curve": "0.2.0"
  }
}
